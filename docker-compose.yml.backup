services:
  postgres:
    restart: always
    image: "postgres:16"
    ports:
      - "5433:5432"
    environment:
      POSTGRES_DB: thingsboard
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
    volumes:
      - postgres-data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 30s
      timeout: 10s
      retries: 3

  thingsboard-ce:
    restart: always
    image: "chakibceran22/tb-node:latest" # Local build with latest changes
    ports:
      - "8081:8080"      # Web UI (ThingsBoard runs on 9090 internally)
      - "7070:7070"      # Edge RPC
      - "1884:1883"      # MQTT
      - "8883:8883"      # MQTT over SSL
      - "5683-5688:5683-5688/udp"  # CoAP and LwM2M
    logging:
      driver: "json-file"
      options:
        max-size: "100m"
        max-file: "10"
    environment:
      # Database Configuration
      SPRING_DATASOURCE_URL: jdbc:postgresql://postgres:5432/thingsboard
      SPRING_DATASOURCE_USERNAME: postgres
      SPRING_DATASOURCE_PASSWORD: postgres
      SPRING_DRIVER_CLASS_NAME: org.postgresql.Driver
      
      # Queue Configuration (In-Memory for simple setup)
      TB_QUEUE_TYPE: in-memory
      
      # JVM Options
      JAVA_OPTS: "-Xms1g -Xmx2g"
      
    volumes:
      - tb-data:/data
      - tb-logs:/var/log/thingsboard
    depends_on:
      postgres:
        condition: service_healthy

volumes:
  postgres-data:
    name: tb-postgres-data
    driver: local
  tb-data:
    name: tb-data
    driver: local
  tb-logs:
    name: tb-logs
    driver: local
